# Floatra Generic REST Adapter — Mode B
# Copy to `.env` and fill in for your deployment.

# Where to find per-platform config files.
# Each file is named <platform_id>.json (e.g. configs/plat_001.json).
# Directory is resolved relative to the project root.
CONFIG_DIR=./configs

# Port the adapter listens on for both ERP inbound and Floatra webhooks.
PORT=3100

# Comma-separated list of platform_id values to load on startup.
# If empty, the adapter loads every *.json file in CONFIG_DIR.
# Useful for multi-tenant deployments to restrict which configs apply.
ENABLED_PLATFORM_IDS=

# When the Floatra gateway returns 5xx and `unavailability_fallback`
# in the config is set to ALLOW_ON_CREDIT, the adapter requires this
# env var to also be `true`. Defence-in-depth so a misconfigured
# config file alone can't open the credit floodgates.
ALLOW_FALLBACK_ON_CREDIT_OVERRIDE=false

# When true, the adapter pings every loaded platform's
# floatra_gateway_url + /platform/health on startup with a 10s
# timeout per platform. If ANY ping fails the process aborts boot
# with a clear error. Useful in production to catch misconfigured
# gateway URLs / network rules at deploy time rather than at first
# ERP request. Defaults to false (logs warnings on failure but
# continues to boot).
STRICT_GATEWAY_HEALTHCHECK=false

# Standard log level (NestJS Logger). Comma-separated subset of:
# log,error,warn,debug,verbose
LOG_LEVELS=log,error,warn
